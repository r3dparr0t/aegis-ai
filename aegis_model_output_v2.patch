                                 &mut accumulated_lessons,
@@ -435,7 +439,7 @@ impl ExecutionEngine {
                         current_attempt,
                         &request,
                         &response,
-                        &response.output,
+                        &raw_model_output,
                         &eval_result,
                         &lesson_ids_used_this_attempt,
                         &mut accumulated_lessons,
@@ -475,7 +479,7 @@ impl ExecutionEngine {
                                 current_attempt,
                                 &request,
                                 &response,
-                                &response.output,
+                                &raw_model_output,
                                 &eval_result,
                                 &lesson_ids_used_this_attempt,
                                 &mut accumulated_lessons,
